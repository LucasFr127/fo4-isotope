{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FO4Isotope runtime manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "runtime",
    "shaderSetId",
    "semanticStages",
    "shaders",
    "resourceRules",
    "manualValidation"
  ],
  "definitions": {
    "observerAddress": {
      "type": "object", "required": ["addressLibraryId", "rva"],
      "properties": {
        "addressLibraryId": { "type": "integer", "minimum": 1 },
        "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" }
      }, "additionalProperties": false
    },
    "approvedHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "hashOrPlaceholder": {
      "anyOf": [
        { "$ref": "#/definitions/approvedHash" },
        { "enum": ["FILL_LOCAL", "UNVALIDATED"] }
      ]
    }
  },
  "properties": {
    "experimentalScreenUiObserver": {
      "type": "object",
      "required": ["status", "scope", "abi", "authorityGap", "evidenceQualification", "lifetime", "thread", "completion", "target", "calls"],
      "properties": {
        "status": { "const": "unvalidated" },
        "scope": { "const": "screen-space-ui-encoded-entry" },
        "abi": { "const": "void(UI*)" },
        "authorityGap": { "type": "string", "minLength": 1 },
        "evidenceQualification": { "type": "string", "minLength": 1 },
        "lifetime": { "type": "string", "minLength": 1 },
        "thread": { "type": "string", "minLength": 1 },
        "completion": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object", "required": ["addressLibraryId", "rva", "expectedBytes"],
          "properties": {
            "addressLibraryId": { "type": "integer", "minimum": 1 },
            "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "expectedBytes": {
              "type": "array", "minItems": 32, "maxItems": 32,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          },
          "additionalProperties": false
        },
        "calls": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "$ref": "#/properties/experimentalArmorUiObserver/properties/calls/items" }
        }
      },
      "additionalProperties": false
    },
    "nativeUiResources": {
      "type": "object",
      "required": ["status", "scope", "abi", "authorityGap", "evidenceQualification", "lifetime", "thread", "propertiesSize", "formatOffset", "sourceFormat", "promotedFormat", "mode", "target", "calls"],
      "properties": {
        "status": { "const": "unvalidated" },
        "scope": { "const": "dedicated-pause-blur-fp16" },
        "abi": { "const": "void(RenderTargetManager*,int32_t,const RenderTargetProperties*,uint8_t)" },
        "authorityGap": { "type": "string", "minLength": 1 },
        "evidenceQualification": { "type": "string", "minLength": 1 },
        "lifetime": { "type": "string", "minLength": 1 },
        "thread": { "type": "string", "minLength": 1 },
        "propertiesSize": { "const": 32 },
        "formatOffset": { "const": 8 },
        "sourceFormat": { "const": 24 },
        "promotedFormat": { "const": 10 },
        "mode": { "const": 1 },
        "target": {
          "type": "object", "required": ["addressLibraryId", "rva", "expectedBytes"],
          "properties": {
            "addressLibraryId": { "type": "integer", "minimum": 1 },
            "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "expectedBytes": {
              "type": "array", "minItems": 16, "maxItems": 16,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }, "additionalProperties": false
        },
        "calls": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "required": ["callerAddressLibraryId", "callerRva", "rva", "slot", "expectedBytes"],
            "properties": {
              "callerAddressLibraryId": { "type": "integer", "minimum": 1 },
              "callerRva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
              "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
              "slot": { "enum": [24, 25] },
              "expectedBytes": {
                "type": "array", "minItems": 5, "maxItems": 5,
                "items": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            }, "additionalProperties": false
          }
        }
      }, "additionalProperties": false
    },
    "imageSpaceObserver": {
      "type": "object",
      "required": ["status", "scope", "authorityGap", "lifetime", "thread", "weatherGrade", "globals", "targets", "calls"],
      "properties": {
        "status": { "const": "unvalidated" },
        "scope": { "const": "weather-imagespace-provenance" },
        "authorityGap": { "type": "string", "minLength": 1 },
        "lifetime": { "type": "string", "minLength": 1 },
        "thread": { "type": "string", "minLength": 1 },
        "weatherGrade": {
          "type": "object",
          "required": ["sunlightColorIndex", "glareColorIndex", "rgbByteShifts", "loadedColorSemantics"],
          "properties": {
            "sunlightColorIndex": { "const": 4 },
            "glareColorIndex": { "const": 15 },
            "rgbByteShifts": { "const": [0, 8, 16] },
            "loadedColorSemantics": { "type": "string", "minLength": 1 }
          }, "additionalProperties": false
        },
        "globals": {
          "type": "object", "required": ["lut", "base"],
          "properties": {
            "lut": { "$ref": "#/definitions/observerAddress" },
            "base": { "$ref": "#/definitions/observerAddress" }
          }, "additionalProperties": false
        },
        "targets": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "required": ["name", "addressLibraryId", "rva", "abi", "expectedBytes"],
            "properties": {
              "name": { "enum": ["Weather", "Accumulate", "RoomBlend", "SetLut"] },
              "addressLibraryId": { "type": "integer", "minimum": 1 },
              "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
              "abi": { "type": "string", "minLength": 1 },
              "expectedBytes": {
                "type": "array", "minItems": 1, "maxItems": 32,
                "items": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            }, "additionalProperties": false
          }
        },
        "calls": {
          "type": "array", "minItems": 11, "maxItems": 11,
          "items": {
            "type": "object", "required": ["callerAddressLibraryId", "callerRva", "rva", "targetIndex", "expectedBytes"],
            "properties": {
              "callerAddressLibraryId": { "type": "integer", "minimum": 1 },
              "callerRva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
              "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
              "targetIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
              "expectedBytes": {
                "type": "array", "minItems": 5, "maxItems": 5,
                "items": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            }, "additionalProperties": false
          }
        }
      }, "additionalProperties": false
    },
    "nativeLutObserver": {
      "type": "object",
      "required": ["status", "scope", "abi", "authorityGap", "lifetime", "effectSubobjectOffset", "textureSrvOffset", "target"],
      "properties": {
        "status": { "const": "unvalidated" },
        "scope": { "const": "synchronous-gamma-correct-lut-render" },
        "abi": { "const": "void(ImageSpaceEffect*,BSTriShape*,ImageSpaceEffectParam*)" },
        "authorityGap": { "type": "string", "minLength": 1 },
        "lifetime": { "type": "string", "minLength": 1 },
        "effectSubobjectOffset": { "const": 280 },
        "textureSrvOffset": { "const": 0 },
        "target": {
          "type": "object",
          "required": ["addressLibraryId", "rva", "expectedBytes"],
          "properties": {
            "addressLibraryId": { "type": "integer", "minimum": 1 },
            "rva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "expectedBytes": {
              "type": "array", "minItems": 25, "maxItems": 25,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "experimentalArmorUiObserver": {
      "type": "object",
      "required": [
        "status",
        "scope",
        "abi",
        "lifetime",
        "thread",
        "authorityGap",
        "hudRendererIdentity",
        "flatRendererIdentity",
        "armorRendererIdentity",
        "rainRendererIdentity",
        "workshopRendererIdentity",
        "target",
        "calls"
      ],
      "properties": {
        "status": {
          "const": "unvalidated"
        },
        "scope": {
          "const": "power-armor-encoded-peak-composition"
        },
        "abi": {
          "const": "void(Renderer*,uint32_t)"
        },
        "lifetime": {
          "type": "string",
          "minLength": 1
        },
        "thread": {
          "type": "string",
          "minLength": 1
        },
        "authorityGap": {
          "type": "string",
          "minLength": 1
        },
        "hudRendererIdentity": {
          "type": "object",
          "required": [
            "status", "comparison", "authorityGap", "keyStorageAddressLibraryId",
            "keyStorageRva", "keyStorageSection", "keyGetterAddressLibraryId",
            "keyGetterRva", "keyGetterExpectedBytes", "modelConstructorRva",
            "modelSetupRva", "modelDestructorRva", "lifetime", "semantics",
            "evidenceQualification"
          ],
          "properties": {
            "status": { "const": "static-reviewed-native-unvalidated" },
            "comparison": { "const": "non-null-native-pooled-entry-pointer" },
            "authorityGap": { "type": "string", "minLength": 1 },
            "keyStorageAddressLibraryId": { "type": "integer", "minimum": 1 },
            "keyStorageRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "keyStorageSection": { "const": ".data" },
            "keyGetterAddressLibraryId": { "type": "integer", "minimum": 1 },
            "keyGetterRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "keyGetterExpectedBytes": {
              "type": "array", "minItems": 26, "maxItems": 26,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "modelConstructorRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "modelSetupRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "modelDestructorRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "lifetime": { "type": "string", "minLength": 1 },
            "semantics": { "type": "string", "minLength": 1 },
            "evidenceQualification": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "flatRendererIdentity": {
          "$ref": "#/properties/experimentalArmorUiObserver/properties/hudRendererIdentity"
        },
        "armorRendererIdentity": {
          "$ref": "#/properties/experimentalArmorUiObserver/properties/hudRendererIdentity"
        },
        "rainRendererIdentity": {
          "$ref": "#/properties/experimentalArmorUiObserver/properties/hudRendererIdentity"
        },
        "workshopRendererIdentity": {
          "type": "object",
          "required": [
            "status", "comparison", "authorityGap", "keyStorageAddressLibraryId",
            "keyStorageRva", "keyStorageSection", "keyInitializerAddressLibraryId",
            "keyInitializerRva", "keyInitializerExpectedBytes", "keyDestructorRva",
            "rendererSetupRva", "menuDestructorRva", "lifetime", "semantics",
            "evidenceQualification"
          ],
          "properties": {
            "status": { "const": "static-reviewed-native-unvalidated" },
            "comparison": { "const": "non-null-native-pooled-entry-pointer" },
            "authorityGap": { "type": "string", "minLength": 1 },
            "keyStorageAddressLibraryId": { "type": "integer", "minimum": 1 },
            "keyStorageRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "keyStorageSection": { "const": ".data" },
            "keyInitializerAddressLibraryId": { "type": "integer", "minimum": 1 },
            "keyInitializerRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "keyInitializerExpectedBytes": {
              "type": "array", "minItems": 39, "maxItems": 39,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            "keyDestructorRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "rendererSetupRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "menuDestructorRva": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
            "lifetime": { "type": "string", "minLength": 1 },
            "semantics": { "type": "string", "minLength": 1 },
            "evidenceQualification": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": [
            "addressLibraryId",
            "rva",
            "expectedBytes"
          ],
          "properties": {
            "addressLibraryId": {
              "type": "integer",
              "minimum": 1
            },
            "rva": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{8}$"
            },
            "expectedBytes": {
              "type": "array",
              "minItems": 23,
              "maxItems": 23,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "additionalProperties": false
        },
        "calls": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "callerAddressLibraryId",
              "callerRva",
              "rva",
              "expectedBytes"
            ],
            "properties": {
              "callerAddressLibraryId": {
                "type": "integer",
                "minimum": 1
              },
              "callerRva": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{8}$"
              },
              "rva": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{8}$"
              },
              "expectedBytes": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "schemaVersion": { "const": 1 },
    "runtime": {
      "type": "object",
      "required": [
        "version",
        "f4seVersion",
        "platform",
        "exeSha256",
        "addressLibraryFile",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^1\\.(10|11)\\.[0-9]+\\.0$"
        },
        "f4seVersion": {
          "type": "string",
          "pattern": "^0\\.[0-9]+\\.[0-9]+$"
        },
        "platform": { "enum": ["steam", "gog", "unvalidated"] },
        "exeSha256": { "$ref": "#/definitions/hashOrPlaceholder" },
        "addressLibraryFile": {
          "type": "string",
          "pattern": "^version-[0-9-]+\\.bin$"
        },
        "status": {
          "enum": [
            "primary-uninitialized",
            "planned",
            "runtime-pinned-unvalidated",
            "capture-complete",
            "release-approved"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "planned" } } },
          "then": {
            "properties": {
              "platform": { "const": "unvalidated" },
              "exeSha256": { "const": "UNVALIDATED" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "runtime-pinned-unvalidated",
                  "capture-complete",
                  "release-approved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "platform": { "enum": ["steam", "gog"] },
              "exeSha256": { "$ref": "#/definitions/approvedHash" }
            }
          }
        }
      ]
    },
    "shaderSetId": { "type": "string", "minLength": 1 },
    "semanticStages": { "type": "array", "items": { "type": "object" } },
    "shaders": { "type": "array", "items": { "type": "object" } },
    "resourceRules": { "type": "array", "items": { "type": "object" } },
    "commonlibObservation": {
      "type": "object",
      "required": [
        "status",
        "relocationSource",
        "relocations",
        "imageSpaceProfile"
      ],
      "properties": {
        "status": {
          "enum": [
            "implementation-pending-runtime-validation",
            "runtime-validated"
          ]
        },
        "uiInteractionProfile": {
          "type": "object",
          "required": ["status", "event", "semantics", "notificationRvas", "cursorMenuConstructorRva", "cursorMenuFlags", "evidenceQualification", "coverageLimit"],
          "properties": {
            "status": { "const": "static-reviewed-native-unvalidated" },
            "event": { "const": "RE::MenuModeChangeEvent" },
            "semantics": { "type": "string", "minLength": 1 },
            "notificationRvas": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" }
            },
            "cursorMenuConstructorRva": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "cursorMenuFlags": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$" },
            "evidenceQualification": { "type": "string", "minLength": 1 },
            "coverageLimit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "relocationSource": {
          "type": "object",
          "required": ["repository", "commit", "path"],
          "properties": {
            "repository": {
              "const": "https://github.com/Dear-Modding-FO4/commonlibf4.git"
            },
            "commit": {
              "const": "491a09a0bc71847ee509e3953621a804c468cb17"
            },
            "path": { "const": "include/RE/IDs.h" }
          },
          "additionalProperties": false
        },
        "relocations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "provider",
              "id",
              "rva",
              "kind",
              "commonlibSymbol"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "id": { "type": "integer", "minimum": 1 },
              "rva": { "type": "integer", "minimum": 1 },
              "kind": {
                "enum": [
                  "pointer-storage",
                  "direct-object",
                  "function"
                ]
              },
              "commonlibSymbol": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              {
                "properties": {
                  "provider": { "const": "image-space-manager" },
                  "kind": { "const": "pointer-storage" },
                  "commonlibSymbol": {
                    "const": "RE::ID::ImageSpaceManager::Singleton"
                  }
                }
              },
              {
                "properties": {
                  "provider": { "const": "renderer-data" },
                  "kind": { "const": "pointer-storage" },
                  "commonlibSymbol": {
                    "const": "RE::ID::BSGraphics::GetRendererData"
                  }
                }
              },
              {
                "properties": {
                  "provider": { "const": "render-target-manager" },
                  "kind": { "const": "direct-object" },
                  "commonlibSymbol": {
                    "const": "RE::ID::BSGraphics::RenderTargetManager::Singleton"
                  }
                }
              },
              {
                "properties": {
                  "provider": { "const": "ui" },
                  "kind": { "const": "pointer-storage" },
                  "commonlibSymbol": { "const": "RE::ID::UI::Singleton" }
                }
              },
              {
                "properties": {
                  "provider": { "const": "ui-event-spin-lock" },
                  "kind": { "const": "function" },
                  "commonlibSymbol": { "const": "RE::ID::BSSpinLock::lock" }
                }
              },
              {
                "properties": {
                  "provider": { "const": "ui-event-memory-manager" },
                  "kind": { "const": "function" },
                  "commonlibSymbol": {
                    "const": "RE::ID::MemoryManager::Singleton"
                  }
                }
              },
              {
                "properties": {
                  "provider": { "const": "ui-event-memory-allocate" },
                  "kind": { "const": "function" },
                  "commonlibSymbol": {
                    "const": "RE::ID::MemoryManager::Allocate"
                  }
                }
              },
              {
                "properties": {
                  "provider": { "const": "ui-event-memory-deallocate" },
                  "kind": { "const": "function" },
                  "commonlibSymbol": {
                    "const": "RE::ID::MemoryManager::Deallocate"
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "imageSpaceProfile": {
          "type": "object",
          "required": [
            "sources",
            "managerSize",
            "currentEofDataOffset",
            "layout",
            "topLevelEffectCount",
            "effects",
            "activeData"
          ],
          "properties": {
            "sources": {
              "type": "object",
              "required": ["commonlib"],
              "properties": {
                "commonlib": {
                  "type": "object",
                  "required": ["repository", "commit", "paths"],
                  "properties": {
                    "repository": {
                      "const": "https://github.com/Dear-Modding-FO4/commonlibf4.git"
                    },
                    "commit": {
                      "const": "491a09a0bc71847ee509e3953621a804c468cb17"
                    },
                    "paths": {
                      "const": [
                        "include/RE/I/ImageSpaceManager.h",
                        "include/RE/I/ImageSpaceBaseData.h",
                        "include/RE/I/ImageSpaceData.h",
                        "include/RE/I/ImageSpaceEffect.h",
                        "include/RE/I/ImageSpaceLUTData.h",
                        "include/RE/N/NiTArray.h"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "managerSize": { "const": 440 },
            "currentEofDataOffset": { "const": 128 },
            "layout": {
              "type": "object",
              "required": ["manager", "primitiveArray", "effect", "lut"],
              "properties": {
                "manager": {
                  "type": "object",
                  "required": [
                    "effectListOffset",
                    "baseDataOffset",
                    "overrideBaseDataOffset",
                    "underwaterBaseDataOffset",
                    "consoleBaseDataOffset",
                    "lutDataOffset",
                    "overrideLutDataOffset",
                    "readyOffset"
                  ],
                  "properties": {
                    "effectListOffset": { "const": 16 },
                    "baseDataOffset": { "const": 96 },
                    "overrideBaseDataOffset": { "const": 104 },
                    "underwaterBaseDataOffset": { "const": 112 },
                    "consoleBaseDataOffset": { "const": 120 },
                    "lutDataOffset": { "const": 304 },
                    "overrideLutDataOffset": { "const": 416 },
                    "readyOffset": { "const": 436 }
                  },
                  "additionalProperties": false
                },
                "primitiveArray": {
                  "type": "object",
                  "required": [
                    "size",
                    "dataOffset",
                    "capacityOffset",
                    "freeIndexOffset",
                    "sizeOffset"
                  ],
                  "properties": {
                    "size": { "const": 24 },
                    "dataOffset": { "const": 8 },
                    "capacityOffset": { "const": 16 },
                    "freeIndexOffset": { "const": 18 },
                    "sizeOffset": { "const": 20 }
                  },
                  "additionalProperties": false
                },
                "effect": {
                  "type": "object",
                  "required": ["storedActiveOffset"],
                  "properties": {
                    "storedActiveOffset": { "const": 8 }
                  },
                  "additionalProperties": false
                },
                "lut": {
                  "type": "object",
                  "required": ["size", "entryCount", "weightOffset", "textureOffset"],
